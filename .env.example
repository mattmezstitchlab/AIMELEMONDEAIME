# Copier ce fichier en `.env` et adapter les valeurs. Ne jamais committer `.env`.

# Base PostgreSQL (requise pour les comptes et les données dynamiques ; le site public s'affiche sans en mode lecture seule)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret de signature des sessions (32+ caractères, aléatoire).
# Si absent, un secret est généré au premier lancement dans `.auth-secret`
# (pratique en développement ; en production, toujours définir AUTH_SECRET
# via l'hébergeur pour maîtriser la rotation).
AUTH_SECRET=

# Déverrouillage du script de démonstration en production (dangereux, voir db/seed.ts)
# ALLOW_DEMO_SEED=1

# Comptes utilisateurs. Laisser vide : le site fonctionne sans compte
# (aucune inscription, aucune connexion). Mettre 1 pour rallumer les comptes,
# les sessions et les espaces /espace, /back-office et /admin.
# AIME_AUTH_ENABLED=1
